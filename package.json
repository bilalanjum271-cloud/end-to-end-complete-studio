{
  "name": "xen-studio",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:web": "pnpm --filter @xen-studio/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:go": "go test ./services/... ./packages/go/...",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "e2e:phase1": "node scripts/e2e-phase1.mjs",
    "e2e:phase2": "cd services/studio && pytest -q"
  },
  "devDependencies": { "pg": "^8.13.1" }
}
