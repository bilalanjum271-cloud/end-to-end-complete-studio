# Xen Studio local configuration. Copy to .env. Never commit real secrets.
# In cloud deployments every value below comes from the vault (see infra/).

# Distributed SQL (CockroachDB in compose; any PostgreSQL-wire database works)
DATABASE_URL=postgresql://root@localhost:26257/xen_studio?sslmode=disable
GLOBAL_DATABASE_URL=postgresql://root@localhost:26257/xen_studio?sslmode=disable

# Redis Cluster (single node locally)
REDIS_URL=redis://localhost:6379

# Auth: HS256 secret shared by identity (signer) and gateway (verifier). >= 32 bytes.
JWT_SECRET=change-me-to-a-long-random-string-of-32+bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Cell identity for this stack copy
CELL_ID=cell-local-1
CELL_REGION=local

# Service ports / upstreams
GATEWAY_ADDR=:8080
IDENTITY_PORT=8101
LEDGER_ADDR=:8102
ROUTER_ADDR=:8103
IDENTITY_URL=http://localhost:8101
LEDGER_URL=http://localhost:8102
ROUTER_URL=http://localhost:8103
GATEWAY_URL=http://localhost:8080

# Internal service-to-service token (ledger/router admin endpoints)
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# Kafka / Temporal / object storage (compose defaults)
KAFKA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
TEMPORAL_ADDRESS=localhost:7233
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=xenstudio
S3_SECRET_KEY=xenstudio-secret
S3_BUCKET_MEDIA=xen-media

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info

# AI providers: leave empty to use mock adapters (whole platform runs with no keys)
MODEL_ROUTER_MODE=mock

# Studio service (Phase 2)
STUDIO_PORT=8104
STUDIO_URL=http://localhost:8104
ORCHESTRATOR=local            # "temporal" in any shared environment; "local" is in-process and not durable
MEDIA_ROOT=./.media           # local-directory storage until the S3 adapter lands
CREDITS_PER_VIDEO_MINUTE=10
# XEN_MOCK_FAIL=llm:mock-primary   # chaos: make a mock provider fail to exercise failover

# ── Real AI providers (leave empty for mocks; each one switches on automatically) ──
MODEL_ROUTER_MODE=auto        # auto | mock | live
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
STABILITY_API_KEY=
MESHY_API_KEY=
RESEND_API_KEY=
EMAIL_FROM="Xen Studio <notifications@example.com>"
INGEST_ALLOW_NETWORK=0        # 1 lets the Animation Studio fetch pages from links
# Optional model overrides: XEN_OPENAI_MODEL, XEN_ANTHROPIC_MODEL, XEN_ELEVENLABS_VOICE, XEN_OPENAI_IMAGE_MODEL ...

# ── Payments (leave empty for the simulated checkout) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
# Regional prices, optional: STRIPE_PRICE_PRO_PK=, STRIPE_PRICE_STUDIO_IN= ...
WEB_URL=http://localhost:3000

# ── Events ──
EVENT_SINK=jsonl              # jsonl (local lake under services/studio/.lake) | kafka
LAKE_ROOT=./.lake
